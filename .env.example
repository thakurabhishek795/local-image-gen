# =============================================================================
# Local Image Generation Studio Configuration (.env)
# =============================================================================

# Default active model on server startup
# Options:
#   - sd15        : Stable Diffusion 1.5 (~4GB VRAM, fast lightweight)
#   - sdxl_turbo  : SDXL Turbo (~6-8GB VRAM, ultra-fast 1-4 step inference)
#   - sdxl        : Stable Diffusion XL Base 1.0 (8GB+ VRAM, high detail)
#   - flux_schnell: FLUX.1 [schnell] (12GB+ VRAM, state-of-the-art 4-step)
MODEL_KEY=sd15

# Network binding
# Host 0.0.0.0 allows LAN & Tailscale remote access
HOST=0.0.0.0
PORT=7860

# Hardware Backend & Precision
# DEVICE: auto | cuda | mps | cpu
DEVICE=auto

# TORCH_DTYPE: auto | float16 | bfloat16 | float32
# 'auto' automatically selects bfloat16 for FLUX/Ampere CUDA, float16 for SD/MPS, float32 for CPU
TORCH_DTYPE=auto

# Memory Optimization & Low-VRAM Safeguards
# ENABLE_CPU_OFFLOAD: auto | model | sequential | none
# 'auto' automatically applies sequential offload on <=6GB GPUs, model offload on <=11GB GPUs.
ENABLE_CPU_OFFLOAD=auto

# Slices attention computation in chunks to drastically reduce peak VRAM
ENABLE_ATTENTION_SLICING=true

# Slices VAE decode in chunks (helps avoid OOM during the final decoding phase)
ENABLE_VAE_SLICING=true

# Tiles VAE decode for very high resolution images (prevents VAE OOM at 1024x1024+)
ENABLE_VAE_TILING=false

# Directory where generated PNG images will be stored
OUTPUT_DIR=app/outputs

# Optional Hugging Face Access Token (required only if accessing gated models)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
